APP_PORT=8080
APP_HOST=0.0.0.0
# Published Docker port (container always listens on 8080).
APP_PUBLIC_PORT=8080
APP_BIND_ADDRESS=0.0.0.0
WEATHER_TIMEOUT_SECONDS=4.0
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_FALLBACK_MODELS=google/gemini-2.0-flash-001,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free,openrouter/free
# Optional independent fallback (uses the same server-side tools).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
POSTGRES_PASSWORD=travel_demo
# Docker Compose sets DATABASE_URL automatically. Without it local runs use SQLite.
# DATABASE_URL=postgresql+psycopg://travel:travel_demo@localhost:5432/travel

# Флаг использования Яндекс Расписаний (true — живой API при наличии ключей, false — мок-данные из каталога).
YANDEX_RASP_ENABLED=true
# Яндекс Расписания: один или несколько ключей через запятую (необязательно).
YANDEX_RASP_API_KEYS=
