# Список переменных окружения.
# Для запуска скопируйте .env.defaults в .env.
APP_PORT=
APP_HOST=
APP_PUBLIC_PORT=
APP_BIND_ADDRESS=
WEATHER_TIMEOUT_SECONDS=
# Ключ OpenRouter хранится в локальном .env.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
# Модель по умолчанию: google/gemini-3.5-flash-lite. Несекретные значения — в .env.defaults.
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=
# Необязательный независимый провайдер Groq; свой ключ из кабинета Groq.
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL=
GROQ_FALLBACK_MODELS=
# Пароль вашей локальной PostgreSQL; демозначение — в .env.defaults.
POSTGRES_PASSWORD=
# Compose задаёт URL автоматически; для своей внешней PostgreSQL укажите строку подключения, без URL локально используется SQLite.
DATABASE_URL=

# Флаг использования Яндекс Расписаний (true — живой API при наличии ключей, false — мок-данные из каталога).
YANDEX_RASP_ENABLED=
# Яндекс Расписания: один или несколько ключей через запятую (необязательно).
YANDEX_RASP_API_KEYS=
