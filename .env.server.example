# Copy to .env on the server and fill in the secrets there.
# Keep this name stable: it also identifies the database volume.
COMPOSE_PROJECT_NAME=travelaichatbot

# Bind to localhost when using the server's existing reverse proxy.
# For direct access by server IP set APP_BIND_ADDRESS=0.0.0.0.
APP_BIND_ADDRESS=127.0.0.1
APP_PUBLIC_PORT=18080
APP_HOST=0.0.0.0
APP_PORT=8080

# Required. Generate a long random password using letters and digits.
POSTGRES_PASSWORD=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_FALLBACK_MODELS=google/gemini-2.0-flash-001,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free,openrouter/free
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
WEATHER_TIMEOUT_SECONDS=4.0

# Флаг использования Яндекс Расписаний (true — живой API при наличии ключей, false — мок-данные из каталога).
YANDEX_RASP_ENABLED=true
# Яндекс Расписания: один или несколько ключей через запятую (необязательно).
YANDEX_RASP_API_KEYS=
